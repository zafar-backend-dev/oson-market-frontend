{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/catalog/:path*", "destination": "/index.html" },
    { "source": "/products/:path*", "destination": "/index.html" },
    { "source": "/branches", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/security", "destination": "/index.html" },
    { "source": "/orders/:path*", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "/index.html" }
  ]
}
